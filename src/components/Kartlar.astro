---
// Çevirmeli kelime kartları. Kullanım: <Kartlar kartlar={[{ tur, fr, tr, ornek }]} />
interface Kart { tur: string; fr: string; tr: string; ornek: string }
const { kartlar } = Astro.props as { kartlar: Kart[] };
---
<section class="tam kartlar">
  <div class="k-grid">
    {kartlar.map((k) => (
      <button type="button" class="fc" aria-pressed="false">
        <span class="mono fc-tur">{k.tur}</span>
        <span class="fc-fr" lang="fr">{k.fr}</span>
        <span class="fc-back">
          <span class="fc-tr">= {k.tr}</span>
          <span class="fc-ex" lang="fr">« {k.ornek} »</span>
        </span>
        <span class="mono fc-hint">dokun →</span>
      </button>
    ))}
  </div>
</section>

<style>
  .k-grid { max-width: 1180px; margin: 0 auto; padding: 0 clamp(18px, 4vw, 48px); display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 14px; }
  .fc { text-align: left; cursor: pointer; min-height: 210px; padding: 20px; border: 2px solid var(--murekkep); display: flex; flex-direction: column; background: var(--krem); border-radius: 4px; transition: background .3s, transform .35s cubic-bezier(.3,1.4,.5,1); }
  .fc:hover { transform: rotate(-1deg) translateY(-3px); }
  .fc[aria-pressed='true'] { background: var(--kayisi); }
  .fc-tur { font-size: 11px; opacity: .8; }
  .fc-fr { margin-top: 18px; font-weight: 800; font-size: 26px; line-height: 1.05; letter-spacing: -.015em; }
  .fc-back { display: none; }
  .fc[aria-pressed='true'] .fc-back { display: block; }
  .fc[aria-pressed='true'] .fc-hint { display: none; }
  .fc-tr { display: block; margin-top: 10px; font-weight: 700; font-size: 18px; }
  .fc-ex { display: block; margin-top: 10px; font-size: 15px; font-style: italic; line-height: 1.4; }
  .fc-hint { margin-top: auto; font-size: 12px; opacity: .7; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.fc').forEach((b) =>
    b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'))),
  );
</script>
